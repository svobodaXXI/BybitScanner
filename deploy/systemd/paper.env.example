# Template for /etc/bybitscanner/paper.env (issue #624). Copy, never commit the real file.
# No secrets belong here: Telegram/Bybit credentials stay in machine-local files.
# LIVE stays OFF: these are exactly the gates tools/runtime_intent.py forces off.
BYBITSCANNER_OPERATOR_TOKEN=
LIVE_MARKET_MUTATIONS_ENABLED=false
LIVE_MAINNET_AUTHORIZED=false
LIVE_MARKET_ACCEPTANCE_SINGLE_FLIGHT=false
LIVE_PARITY_MUTATIONS_ENABLED=false
LIVE_LIMIT_MUTATIONS_ENABLED=false
LIVE_MARKET_ACCEPTANCE_NOTIONAL_CEILING=0
LIVE_LIMIT_ACCEPTANCE_NOTIONAL_CEILING=0
LIVE_PARITY_MUTATION_SCOPE=

# A fresh PAPER DB on this host (the main PC PAPER DB is NOT transferred), in the systemd
# StateDirectory, so the service user needs no write access to the repository root.
BYBITSCANNER_PAPER_DB=/var/lib/bybitscanner/paper_runtime.sqlite3

# Same PAPER feature switches as the Windows launch files.
BYBITSCANNER_IKIGAI_BOX_SIGNALS=1
BYBITSCANNER_IKIGAI_BOX_WATCH=0
BYBITSCANNER_L_SHAPE_OBSERVATIONS=1
BYBITSCANNER_MIRROR_RETEST_ROBOT=1
# Owner-approved default for the unified PAPER launch. LIVE remains disabled.
BYBITSCANNER_MIRROR_STANDALONE_ROBOT=1

# Temporary owner-approved PAPER testing policy: daily drawdown gate is disabled.
# PAPER-only; all other Admission/STOP/TAKE/ownership/LIVE isolation gates remain enforced.
# This is a deliberate testing exception: restore the normal gate before production use.
BYBITSCANNER_PAPER_DAILY_LOSS_GATE=DISABLED_FOR_PAPER_DEBUG

# The source tree stays owned by its current owner: do not write bytecode into it.
PYTHONDONTWRITEBYTECODE=1
