# Template for /etc/bybitscanner/owner.env (root:root, mode 600). NEVER commit the real file.
# Read by systemd (as root) for the PAPER backend only. It holds the Autopilot owner token that
# POST /api/robot/autopilot requires for mode=PAPER_AUTO; without it PAPER_AUTO cannot be enabled.
# Do not put LIVE gates or BYBITSCANNER_OPERATOR_TOKEN here (tools.vps_check rejects them).
BYBITSCANNER_AUTOPILOT_OWNER_TOKEN=
