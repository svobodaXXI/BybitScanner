# Optional owner approval adapter; not installed/enabled by ordinary release.
[Unit]
Description=Verify owner Telegram confirmation and submit existing owner monolith
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/bybitscanner/owner-release/config.json
ConditionPathExists=/var/lib/bybitscanner-owner-release/pending.json

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/BybitScanner
EnvironmentFile=/etc/bybitscanner/paper.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/BybitScanner/venv/bin/python -m tools.owner_release_telegram_runtime
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bybitscanner-owner-release
TimeoutStartSec=90
