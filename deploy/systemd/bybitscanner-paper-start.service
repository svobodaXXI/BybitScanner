# One owner command for VPS PAPER core:
#     systemctl start bybitscanner-paper-start.service
# Backend is mandatory. Telegram is best-effort: an unreachable Telegram API
# must not prevent safe Scanner + Robot admission or the core runtime intent.
# Successful oneshot requires canonical runtime intent ALL and authorized
# PAPER_AUTO convergence; unavailable/unsafe components fail closed.
# Telegram remains optional; no boot enable/restart or LIVE escalation.
# Owner must set BYBITSCANNER_VPS_PAPER_AUTO_ON_START=1 and a dedicated
# BYBITSCANNER_AUTOPILOT_OWNER_TOKEN in /etc/bybitscanner/owner.env (root-protected).

[Unit]
Description=BybitScanner PAPER core start (backend, optional Telegram, runtime intent ALL)
Requires=bybitscanner-paper-backend.service
Wants=bybitscanner-telegram.service
After=bybitscanner-paper-backend.service bybitscanner-telegram.service

[Service]
Type=oneshot
User=bybitscanner
Group=bybitscanner
WorkingDirectory=/opt/BybitScanner
EnvironmentFile=/etc/bybitscanner/paper.env
EnvironmentFile=-/etc/bybitscanner/owner.env
ExecStart=/opt/BybitScanner/venv/bin/python -m tools.runtime_intent --no-telegram ALL
ExecStart=/opt/BybitScanner/venv/bin/python -m tools.vps_paper_auto_start
Restart=no
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
