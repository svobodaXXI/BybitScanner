# BybitScanner PAPER backend (issues #624, #627). PREPARED, NOT ENABLED.
#
# There is deliberately NO [Install] section: `systemctl enable` cannot make this
# unit start at boot. It runs only on an explicit, owner-authorized
# `systemctl start` and is never restarted automatically (PAPER fail-closed:
# a crashed trading runtime stays down until a human looks at it).
# Starting it starts the PAPER runtime (Bybit public market data, PAPER recovery,
# protection, Robot monitor); do not start it to "check" the server --
# use `python -m tools.vps_check` instead.
#
# STOP (#627): a plain signal is NOT a safe stop (open Robot positions would lose their
# local STOP/TAKE protection). systemd cannot abort a stop job once it has begun, and a
# refused safe-stop inside a stop job would leave the backend alive but no longer tracked by
# this unit (verified on systemd 255). Therefore:
# * RefuseManualStop=yes: `systemctl stop|restart` of this unit is refused; it stays active,
#   protected and managed. The only manual stop is the canonical owner safe-stop
#   `python -m tools.stop_robot_runtime all` (also behind the Telegram stop buttons):
#   Scanner -> Robot safe-stop -> protection quiescence -> Telegram -> this backend's
#   identity-checked /api/runtime/shutdown, after which the process exits by itself and the
#   unit ends cleanly. A blocked safe-stop changes nothing.
# * ExecStop runs the same safe-stop for stops systemd starts itself (host shutdown, a
#   Conflicts= job). If it is blocked there, the stop signal is a harmless SIGCONT and SIGKILL
#   is disabled, so the process is not killed by this unit (the host shutdown itself ends it).
# This guards against operator mistakes, not against root: `systemctl kill -s KILL`,
# `kill -9`, editing the unit or a host reboot can still end the process.

[Unit]
Description=BybitScanner PAPER backend (127.0.0.1:8765, PAPER only)
RefuseManualStop=yes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bybitscanner
Group=bybitscanner
WorkingDirectory=/opt/BybitScanner
EnvironmentFile=/etc/bybitscanner/paper.env
# Optional, root-only (600): the Autopilot owner token for PAPER_AUTO (owner.env.example).
EnvironmentFile=-/etc/bybitscanner/owner.env
# PAPER DB and its side files live here (created by systemd for User= on a start only).
StateDirectory=bybitscanner
StateDirectoryMode=0750
ExecStartPre=/opt/BybitScanner/venv/bin/python -m tools.vps_check --pre-start
# Validate every tracked release blob against the protected staging manifest and
# set BYBITSCANNER_BUILD_SHA in the same PID at exec (no separate untrusted marker).
# The manifest is installed only after verified immutable release staging.
ExecStart=/opt/BybitScanner/venv/bin/python -m tools.vps_release_identity exec-backend
ExecStop=/opt/BybitScanner/venv/bin/python -m tools.stop_robot_runtime all
Restart=no
KillSignal=SIGCONT
SendSIGKILL=no
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true
