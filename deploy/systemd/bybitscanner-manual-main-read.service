# MANUAL MAIN read-only service. The authorized Gitless EDITOR_ONLY monolith
# may install/start this unit only after authenticated ingress attestation.
# It is never enabled at boot and has no trading, PAPER DB or Robot authority.
# Unlike PaperRuntime this process has no Robot/PAPER DB/STOP/TAKE owner.
[Unit]
Description=BybitScanner manual MAIN read gateway (loopback, no trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bybitscanner
Group=bybitscanner
WorkingDirectory=/opt/BybitScanner
Environment=BYBITSCANNER_MAIN_STATE_DIR=/var/lib/bybitscanner-manual-main
StateDirectory=bybitscanner-manual-main
StateDirectoryMode=0700
ExecStart=/opt/BybitScanner/venv/bin/python -m terminal.runtime.manual_main_read_server
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bybitscanner-manual-main
UMask=0077
# The service has no Install section: cannot auto-enable itself.
