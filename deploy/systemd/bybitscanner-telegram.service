# BybitScanner Telegram monitoring worker (issues #624, #627). PREPARED, NOT ENABLED.
#
# No [Install] section (cannot be enabled) and Restart=no, like the backend.
# KillMode=process (#627): the worker's own "stop" buttons start tools.stop_robot_runtime as an
# independent helper (own session) that outlives the worker it shuts down. With the default
# control-group kill, systemd would reap that helper the moment the worker exits and the
# backend would be left half-stopped. Stopping only the worker is not safety-relevant: the
# backend (not this unit) owns protection.
# It needs the machine-local config.py with the Telegram token, which is never
# stored in Git; do not start it before the owner authorizes Telegram on this host.

[Unit]
Description=BybitScanner Telegram monitoring (PAPER backend client)
After=bybitscanner-paper-backend.service
Requires=bybitscanner-paper-backend.service

[Service]
Type=simple
User=bybitscanner
Group=bybitscanner
WorkingDirectory=/opt/BybitScanner
EnvironmentFile=/etc/bybitscanner/paper.env
# Same Gateway transport file as Scanner/backend; do not duplicate secrets.
EnvironmentFile=-/etc/bybitscanner/telegram-gateway.env
# PAPER DB and its side files live here (created by systemd for User= on a start only).
StateDirectory=bybitscanner
StateDirectoryMode=0750
# Readiness: start only once the canonical PAPER backend for the configured PAPER DB answers
# (first start creates the DB; the worker must not race it).
ExecStartPre=/opt/BybitScanner/venv/bin/python -m tools.runtime_intent --wait-backend
ExecStart=/opt/BybitScanner/venv/bin/python /opt/BybitScanner/telegram_monitoring.py
Restart=no
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
