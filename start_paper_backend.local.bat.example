@echo off
rem Copy this file to start_paper_backend.local.bat for a machine-local proxy override.
rem Leave the value empty on machines that connect to Bybit directly.
set "BYBITSCANNER_BYBIT_PROXY=socks5h://127.0.0.1:10808"

rem Optional: frozen Scanner signal geometry in EDITOR requires the same
rem 32+ character dedicated BYBITSCANNER_SIGNAL_GEOMETRY_TOKEN in backend and Workspace.
rem Keep the actual token only in ignored machine-local configuration.
rem This is NOT the LIVE operator token: it must not change PAPER_SAFE gates.
rem NEVER put it in Git, browser URLs, Telegram messages or QR codes.
rem set "BYBITSCANNER_SIGNAL_GEOMETRY_TOKEN=<machine-local-secret-at-least-32-characters>"
